{
  "name": "payflow",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source payment infrastructure for Stellar",
  "scripts": {
    "dev": "pnpm --filter \"./apps/**\" dev",
    "build": "pnpm --filter \"./apps/**\" build",
    "test": "pnpm --filter \"./packages/**\" test && pnpm --filter \"./apps/**\" test",
    "lint": "pnpm --filter \"./apps/**\" lint && pnpm --filter \"./packages/**\" lint",
    "clean": "rm -rf node_modules **/node_modules **/.next **/dist",
    "db:generate": "pnpm --filter @payflow/database db:generate",
    "db:migrate": "pnpm --filter @payflow/database db:migrate",
    "db:studio": "pnpm --filter @payflow/database db:studio",
    "contract:build": "pnpm --filter @payflow/contract build",
    "contract:test": "pnpm --filter @payflow/contract test",
    "contract:deploy:testnet": "pnpm --filter @payflow/contract deploy:testnet"
  },
  "keywords": [
    "stellar",
    "soroban",
    "payments",
    "blockchain",
    "crypto"
  ],
  "author": "PayFlow Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}

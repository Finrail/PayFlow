{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"],
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "@payflow/database": ["../../packages/database/dist"],
      "@payflow/stellar": ["../../packages/stellar/dist"],
      "@payflow/types": ["../../packages/types/dist"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
